---
import type { CollectionEntry } from 'astro:content';

interface Props {
  pub: CollectionEntry<'publications'>['data'];
}

const { pub } = Astro.props;

// Where the title should link to: the DOI if there is one, else the publisher URL
const mainLink = pub.doi ? `https://doi.org/${pub.doi}` : pub.url;

const typeLabels = {
  journal: 'Journal article',
  'book-chapter': 'Book chapter',
  preprint: 'Preprint',
  conference: 'Conference paper',
};

// Build the "Journal, 129(51), 22482–22489" style line
const volumeIssue = pub.volume
  ? pub.issue ? `${pub.volume}(${pub.issue})` : pub.volume
  : undefined;
const pages = pub.pages
  ? pub.type === 'book-chapter' ? `pp. ${pub.pages}` : pub.pages
  : undefined;
const publisherLine = [volumeIssue, pages, pub.publisher]
  .filter(Boolean)
  .join(', ');
---

<li class="pub">
  <p class="title">
    {mainLink
      ? <a href={mainLink} target="_blank" rel="noopener noreferrer">{pub.title}</a>
      : pub.title}
  </p>
  <p class="authors">
    {pub.authors.map((author, i) => (
      <>
        {author.includes('Oyomo') ? <strong>{author}</strong> : author}
        {i < pub.authors.length - 1 ? ', ' : ''}
      </>
    ))}
  </p>
  <p class="venue">
    {pub.venue && <em>{pub.venue}</em>}{pub.venue && publisherLine ? ', ' : ''}{publisherLine}
  </p>
   <p class="meta">
    <span class="badge">{typeLabels[pub.type]}</span>
    {pub.doi && <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer">DOI</a>}
    {pub.arxiv && <a href={`https://arxiv.org/abs/${pub.arxiv}`} target="_blank" rel="noopener noreferrer">arXiv</a>}
    {!pub.doi && pub.url && <a href={pub.url} target="_blank" rel="noopener noreferrer">Publisher page</a>}
    {pub.pdf && <a href={pub.pdf} target="_blank" rel="noopener noreferrer">PDF</a>}
    {pub.code && <a href={pub.code} target="_blank" rel="noopener noreferrer">Code</a>}
  </p>
</li>

<style>
  .pub {
    margin-bottom: 1.5rem;
  }
  p {
    margin: 0.15rem 0;
  }
  .title {
    font-weight: 600;
  }
  .authors,
  .venue {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .authors strong {
    color: var(--text);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.4rem;
    font-size: 0.85rem;
  }
  .badge {
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }

    .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
---
import type { TimelineEntry } from '../data/CV';

interface Props {
  items: TimelineEntry[];
}

const { items } = Astro.props;
---

<ol class="timeline">
  {items.map((item) => (
    <li>
      <p class="period">{item.period}</p>
      <h3>{item.title}</h3>
      <p class="org">{item.organisation}, {item.location}</p>
      {item.details && item.details.length > 0 && (
        <ul>
          {item.details.map((d) => <li>{d}</li>)}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid var(--border);
  }
  .timeline > li {
    position: relative;
    margin-bottom: 1.75rem;
  }
  /* the dot on the line */
  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 6px);
    top: 0.4rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .period {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  h3 {
    margin: 0.1rem 0 0;
    font-size: 1.1rem;
  }
  .org {
    margin: 0 0 0.4rem;
    color: var(--muted);
  }
  ul {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }
</style>